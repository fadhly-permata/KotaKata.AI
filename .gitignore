deploy.tar.gz
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — never commit secrets
.env
.env.*
!.env.example

# lockfile npm (proyek memakai bun)
package-lock.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# CodeGraph local index
.codegraph/

# Report artefak dari script riset/QA vocab (tidak untuk di-commit)
scripts/vocab/*-report.json

# Artefak lokal Freebuff (sqlite desktop, bukan bagian proyek)
.freebuff/
